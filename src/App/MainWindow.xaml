                        <UniformGrid x:Name="StatisticsItems" Columns="4">

                        <StackPanel Grid.Column="0" Margin="13" ToolTip="{Binding TargetResolutionDisplay}">
                            <TextBlock TextWrapping="Wrap" Text="{DynamicResource ResolutionLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Resolution}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="ResolutionValue"/>

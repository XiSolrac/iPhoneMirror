                                       ToolTip="{DynamicResource NavDriverDescription}"
                                       AutomationProperties.AutomationId="DriverManagerButton">
                    <ui:NavigationViewItem.Icon>
                        <controls:ThemedSymbolIcon Style="{StaticResource NavigationSymbolIcon}" Symbol="DeveloperBoard20" FontSize="20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="AboutButton"
                                       Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavAbout}"
                                       Click="OnNavigateAboutClick"
                                       ToolTip="{DynamicResource NavAboutDescription}"
                                       AutomationProperties.AutomationId="AboutButton">
                    <ui:NavigationViewItem.Icon>
                        <controls:ThemedSymbolIcon Style="{StaticResource NavigationSymbolIcon}" Symbol="Info24" FontSize="20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="RootLayout" Margin="12,18,18,18"
                      animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="HeaderGapRow" Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderPanel" Grid.Row="0" Background="Transparent"
                Margin="-12,-18,-18,0" Padding="12,18,18,0"
                MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="WorkspaceHeading" VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSize24}" FontWeight="SemiBold" Text="iPhoneMirror"/>
            </StackPanel>
            <Border x:Name="DetectionStatus" Grid.Column="1" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" MaxWidth="640">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLightweightApplicationMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <WrapPanel x:Name="StatusPills" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}" MaxWidth="280" ToolTip="{Binding DriverState}"
                            AutomationProperties.AutomationId="DriverStatusPill">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusPillDot}" Fill="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="{Binding DriverState}" Style="{StaticResource StatusPillText}"/>
                        </StackPanel>
                    </Border>
                    <Border ToolTip="{DynamicResource StatusPillMirroring}" AutomationProperties.AutomationId="MirroringStatusPill">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusPillDot}" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{DynamicResource StatusPillMirroring}" Style="{StaticResource StatusPillText}"/>
                        </StackPanel>
                    </Border>
                    <Border AutomationProperties.AutomationId="ControlStatusPill">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveControlLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusPillDot}" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding ActiveControlLabel}" Style="{StaticResource StatusPillText}"/>
                        </StackPanel>
                    </Border>
                    <Border ToolTip="{DynamicResource PreviewUnmute}" AutomationProperties.AutomationId="MutedStatusPill">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="SpeakerMute20" FontSize="14" Margin="0,0,6,0"
                                           Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource StatusPillMuted}" Style="{StaticResource StatusPillText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}" ToolTip="{Binding WirelessStatus}"
                            AutomationProperties.AutomationId="AirPlayStatusPill">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusPillDot}" chrome:StatusAppearance.Tone="{Binding WirelessStatusTone}"/>
                            <TextBlock Text="{DynamicResource StatusPillAirPlay}" Style="{StaticResource StatusPillText}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Border>
            <StackPanel x:Name="HeaderCaptureActions" Grid.Column="3"
                        Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">

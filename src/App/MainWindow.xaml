                    <ui:NavigationViewItem.Icon>
                        <controls:ThemedSymbolIcon Style="{StaticResource NavigationSymbolIcon}" Symbol="VideoRecording20" FontSize="20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="DriverManagerButton"
                                       Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavDriver}"

                                     AutomationProperties.AutomationId="SettingsTabControl"
                                     AutomationProperties.Name="{DynamicResource SettingsTabControl}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Keyboard20" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SettingsTabControl}" FontSize="{DynamicResource CaptionFontSize}"

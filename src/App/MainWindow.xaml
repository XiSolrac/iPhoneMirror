                                       ToolTip="{DynamicResource NavSettingsDescription}"
                                       AutomationProperties.AutomationId="SettingsPanelToggle">
                    <ui:NavigationViewItem.Icon>
                        <controls:ThemedSymbolIcon Style="{StaticResource NavigationSymbolIcon}" Symbol="Settings24" FontSize="20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator/>
                <ui:NavigationViewItem Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavDeviceBinding}"
                                       Click="OnNavigateReverseControlClick"
                                       ToolTip="{DynamicResource NavDeviceBindingDescription}"
                                       AutomationProperties.AutomationId="DeviceBindingNavButton">
                    <ui:NavigationViewItem.Icon>
                        <controls:ThemedSymbolIcon Style="{StaticResource NavigationSymbolIcon}" Symbol="UsbPlug24" FontSize="20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavOutput}"
                                       Click="OnNavigateOutputClick"
                                       ToolTip="{DynamicResource NavOutputDescription}"

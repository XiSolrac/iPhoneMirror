                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SettingsTabApp" Style="{StaticResource SettingsTabButton}" GroupName="SettingsTab"
                                     Tag="App" Checked="OnSettingsTabChecked"
                                     AutomationProperties.AutomationId="SettingsTabApp"
                                     AutomationProperties.Name="{DynamicResource SettingsTabApp}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Options20" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SettingsTabApp}" FontSize="{DynamicResource CaptionFontSize}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource ContentEdgeScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <Grid Margin="0,0,10,0">

                    <!-- Video & sound -->
                    <StackPanel x:Name="SettingsPageVideo">
                        <Expander x:Name="SettingsSectionUsbMode" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource UsbProjectionModeTitle}"
                                  Visibility="{Binding UsbProjectionSettingsVisibility}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="UsbPlug20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <controls:InfoRow>
                                            <TextBlock Text="{DynamicResource UsbProjectionModeTitle}" Style="{StaticResource ControlSectionTitle}" VerticalAlignment="Center"/>
                                            <controls:InfoTip Text="{DynamicResource UsbProjectionPerDeviceHint}"/>
                                        </controls:InfoRow>
                                        <TextBlock Text="{Binding SelectedUsbProjectionMode.Label}" Style="{StaticResource SettingsSectionSummary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Border Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12"
                                        Padding="2">
                                    <ListBox ItemsSource="{Binding UsbProjectionModes}"
                                             SelectedItem="{Binding SelectedUsbProjectionMode, Mode=TwoWay}"
                                             IsEnabled="{Binding CanChangeUsbProjectionMode}"
                                             ItemContainerStyle="{StaticResource UsbModeTabItem}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <controls:InfoRow>
                                                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource SecondaryFontSize}"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                               TextAlignment="Left" VerticalAlignment="Center"
                                                               Margin="4,0,0,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                    <!-- Follows the item color so it stays readable on the selected accent fill. -->
                                                    <controls:InfoTip Text="{Binding InfoText}" Opacity="0.85"
                                                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                </controls:InfoRow>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <CheckBox Content="{DynamicResource UsbAudioCaptureLabel}"
                                          IsChecked="{Binding CaptureUsbAudio, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChangeUsbAudioCapture}"
                                          Visibility="{Binding WiredVideoLimitSettingsVisibility}"
                                          Margin="0,12,0,0"
                                          AutomationProperties.AutomationId="UsbAudioCaptureCheckBox"/>
                            </StackPanel>
                        </Expander>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMediaCasting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Expander x:Name="SettingsSectionPicture" Style="{StaticResource SettingsSection}"
                                      AutomationProperties.Name="{DynamicResource PictureQualityTitle}"
                                      Visibility="{Binding VideoSettingsVisibility}">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border Style="{StaticResource SettingsSectionIcon}">
                                            <ui:SymbolIcon Symbol="Image20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource PictureQualityTitle}" Style="{StaticResource ControlSectionTitle}"/>
                                            <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource SettingsSectionSummary}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <StackPanel Visibility="{Binding WiredVideoLimitSettingsVisibility}">
                                        <controls:InfoRow Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource RenderResolutionLimit}" Style="{StaticResource DetailLabel}" Margin="0"/>
                                            <controls:InfoTip Text="{DynamicResource RenderLimitHelp}"/>
                                        </controls:InfoRow>
                                        <ComboBox AutomationProperties.Name="{DynamicResource RenderResolutionLimit}" x:Name="ResolutionComboBox"
                                                  ItemsSource="{Binding ResolutionPresets}"
                                                  DisplayMemberPath="Label"
                                                  IsEnabled="{Binding CanChangeVideoPipeline}"
                                                  SelectedItem="{Binding SelectedResolutionPreset, Mode=TwoWay}"/>

                                        <TextBlock Text="{DynamicResource TargetFrameRate}" Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                        <ComboBox AutomationProperties.Name="{DynamicResource TargetFrameRate}" x:Name="FrameRateComboBox"
                                                  ItemsSource="{Binding FrameRates}"
                                                  IsEnabled="{Binding CanChangeVideoPipeline}"
                                                  SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <controls:InfoRow Margin="0,10,0,5">
                                        <TextBlock Text="{DynamicResource DecoderPreferenceLabel}"
                                                   Style="{StaticResource DetailLabel}" Margin="0"/>
                                        <controls:InfoTip Text="{DynamicResource VideoPipelinePreferenceHelp}"/>
                                    </controls:InfoRow>
                                    <ComboBox AutomationProperties.Name="{DynamicResource DecoderPreferenceLabel}" ItemsSource="{Binding DecoderPreferences}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding CanChangeDecoderPipeline}"
                                              SelectedItem="{Binding SelectedDecoderPreference, Mode=TwoWay}"/>

                                    <controls:InfoRow Margin="0,10,0,0">
                                        <CheckBox Content="{DynamicResource SharpenSmallPreview}"
                                                  IsChecked="{Binding SharpenSmallPreview, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="SharpenSmallPreviewCheckBox"/>
                                        <controls:InfoTip Text="{DynamicResource SharpenSmallPreviewHelp}"/>
                                    </controls:InfoRow>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ApplyVideoSettingsButton"
                                                Content="{DynamicResource ApplyVideoSettings}"
                                                Command="{Binding ApplyVideoSettingsCommand}"
                                                Style="{StaticResource ToolButton}"/>
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource MoreImageSettingsButton}"
                                                Command="{Binding MoreImageSettingsCommand}"
                                                Style="{StaticResource ToolButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="SettingsSectionSound" Style="{StaticResource SettingsSection}"
                                      AutomationProperties.Name="{DynamicResource SoundTitle}">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border Style="{StaticResource SettingsSectionIcon}">
                                            <ui:SymbolIcon Symbol="Speaker220" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SoundTitle}" Style="{StaticResource ControlSectionTitle}"/>
                                            <TextBlock Text="{Binding PlaybackVolume, StringFormat={}{0:F0}%}" Style="{StaticResource SettingsSectionSummary}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <CheckBox x:Name="AudioPlaybackCheckBox"
                                              Content="{DynamicResource PlayAudioWindows}"
                                              IsChecked="{Binding PlayAudio, Mode=TwoWay}"/>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource PlaybackVolume}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PlaybackVolume, StringFormat={}{0:F0}%}"
                                                   MinWidth="42" TextAlignment="Right"
                                                   Foreground="{DynamicResource AccentHoverBrush}"
                                                   FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider AutomationProperties.Name="{DynamicResource PlaybackVolume}" x:Name="VolumeSlider"
                                            Minimum="0" Maximum="100"
                                            Value="{Binding PlaybackVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,4,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <Expander x:Name="SettingsSectionToolbar" Style="{StaticResource SettingsSection}" Margin="0,12,0,0"
                                  AutomationProperties.Name="{DynamicResource ToolbarSettingsTitle}"
                                  AutomationProperties.AutomationId="ToolbarSettingsSection">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="Toolbox20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource ToolbarSettingsTitle}" Style="{StaticResource ControlSectionTitle}"/>
                                        <TextBlock Text="{DynamicResource ToolbarSettingsSummary}" Style="{StaticResource SettingsSectionSummary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox Content="{DynamicResource StopMirroring}"
                                          IsChecked="{Binding ShowToolbarStop, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarStopCheckBox"/>
                                <CheckBox Content="{DynamicResource WirelessControlLabel}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarWirelessControl, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarWirelessControlCheckBox"/>
                                <CheckBox Content="{DynamicResource WiredControlLabel}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarUsbControl, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarUsbControlCheckBox"/>
                                <CheckBox Content="{DynamicResource BluetoothControlLabel}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarBluetoothControl, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarBluetoothControlCheckBox"/>
                                <CheckBox Content="{DynamicResource MediaOutputButton}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarMediaOutput, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarMediaOutputCheckBox"/>
                                <CheckBox Content="{DynamicResource PlaybackVolume}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarVolume, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarVolumeCheckBox"/>
                                <CheckBox Content="{DynamicResource IndependentWindowImageSettings}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarImageSettings, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarImageSettingsCheckBox"/>
                                <CheckBox Content="{DynamicResource SeparateWindow}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarPreviewWindow, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarPreviewWindowCheckBox"/>
                                <CheckBox Content="{DynamicResource Screenshot}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarScreenshot, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarScreenshotCheckBox"/>
                                <CheckBox Content="{DynamicResource FullScreenPreview}" Margin="0,8,0,0"
                                          IsChecked="{Binding ShowToolbarFullScreen, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="ShowToolbarFullScreenCheckBox"/>
                            </StackPanel>
                        </Expander>

                    </StackPanel>

                    <!-- Control -->
                    <StackPanel x:Name="SettingsPageControl" Visibility="Collapsed">
                        <Expander x:Name="SettingsSectionKeyboard" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource KeyboardSectionTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="Keyboard20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <controls:InfoRow>
                                            <TextBlock Text="{DynamicResource KeyboardSectionTitle}" Style="{StaticResource ControlSectionTitle}" VerticalAlignment="Center"/>
                                            <controls:InfoTip Text="{DynamicResource KeyboardTypingHelp}"/>
                                        </controls:InfoRow>
                                        <TextBlock Text="{Binding KeyboardInputModeStatus}" Style="{StaticResource SettingsSectionSummary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <controls:InfoRow>
                                    <CheckBox Content="{DynamicResource ArrowKeysSwipe}"
                                              IsChecked="{Binding ArrowKeysSwipe, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="ArrowKeysSwipeCheckBox"/>
                                    <controls:InfoTip Text="{DynamicResource ArrowKeysSwipeHelp}"/>
                                </controls:InfoRow>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SettingsSectionWheel" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource WheelScrollTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="ArrowSort20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource WheelScrollTitle}" Style="{StaticResource ControlSectionTitle}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <controls:InfoRow>
                                    <CheckBox Content="{DynamicResource WiredWheelScroll}"
                                              IsChecked="{Binding WiredWheelScroll, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="WiredWheelScrollCheckBox"/>
                                    <controls:InfoTip Text="{DynamicResource WheelScrollHelp}"/>
                                </controls:InfoRow>
                                <CheckBox Content="{DynamicResource ReverseWheelDirection}" Margin="0,8,0,0"
                                          IsChecked="{Binding ReverseWheelDirection, Mode=TwoWay}"
                                          IsEnabled="{Binding WiredWheelScroll}"
                                          AutomationProperties.AutomationId="ReverseWheelDirectionCheckBox"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SettingsSectionMapping" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource MappingTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="Games20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <controls:InfoRow>
                                            <TextBlock Text="{DynamicResource MappingTitle}" Style="{StaticResource ControlSectionTitle}" VerticalAlignment="Center"/>
                                            <controls:InfoTip Text="{DynamicResource MappingDescription}"/>
                                        </controls:InfoRow>
                                        <TextBlock Text="{Binding KeyboardMappingStatus}" Style="{StaticResource SettingsSectionSummary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Command="{Binding ManageKeyboardMappingCommand}" Style="{StaticResource ToolButton}"
                                        AutomationProperties.AutomationId="OpenKeyboardMappingButton">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Keyboard20" Style="{StaticResource ButtonSymbolIcon}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource MappingManage}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>
                                <controls:InfoRow Margin="0,12,0,0">
                                    <CheckBox Content="{DynamicResource MixMappingAndTyping}"
                                              IsChecked="{Binding MixMappingAndTyping, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="MixMappingAndTypingCheckBox"/>
                                    <controls:InfoTip Text="{DynamicResource MixMappingAndTypingHelp}"/>
                                </controls:InfoRow>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SettingsSectionShortcuts" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource ShortcutsTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="KeyCommand20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <controls:InfoRow>
                                            <TextBlock Text="{DynamicResource ShortcutsTitle}" Style="{StaticResource ControlSectionTitle}" VerticalAlignment="Center"/>
                                            <controls:InfoTip Text="{DynamicResource ShortcutsHelp}"/>
                                        </controls:InfoRow>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Button Content="{DynamicResource OpenShortcutSettings}"
                                        Click="OnShortcutSettingsClick"
                                        Style="{StaticResource ToolButton}" MinWidth="104"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="OpenShortcutSettingsButton"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SettingsSectionBluetoothMouse" Style="{StaticResource SettingsSection}" IsExpanded="False"
                                  AutomationProperties.Name="{DynamicResource BluetoothMouseSettingsTitle}"
                                  Visibility="{Binding VideoSettingsVisibility}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="Cursor20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource BluetoothMouseSettingsTitle}" Style="{StaticResource ControlSectionTitle}"/>
                                        <TextBlock Text="{Binding BluetoothMouseSensitivity, StringFormat={}{0:F0}%}" Style="{StaticResource SettingsSectionSummary}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource BluetoothMouseSensitivity}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BluetoothMouseSensitivity, StringFormat={}{0:F0}%}"
                                               MinWidth="42" TextAlignment="Right"
                                               Foreground="{DynamicResource AccentHoverBrush}"
                                               FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider AutomationProperties.Name="{DynamicResource BluetoothMouseSensitivity}" Minimum="10" Maximum="1000" SmallChange="1" LargeChange="50"
                                        Value="{Binding BluetoothMouseSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,4,0,0" VerticalAlignment="Center"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource BluetoothWheelSensitivity}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BluetoothWheelSensitivity, StringFormat={}{0:F0}%}"
                                               MinWidth="42" TextAlignment="Right"
                                               Foreground="{DynamicResource AccentHoverBrush}"
                                               FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider AutomationProperties.Name="{DynamicResource BluetoothWheelSensitivity}" Minimum="10" Maximum="1000" SmallChange="1" LargeChange="50"
                                        Value="{Binding BluetoothWheelSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,4,0,0" VerticalAlignment="Center"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <controls:InfoRow Margin="0,0,0,5">
                                            <TextBlock Text="{DynamicResource BluetoothPortraitMouseDirection}"
                                                       Style="{StaticResource DetailLabel}" Margin="0"/>
                                            <controls:InfoTip Text="{Binding BluetoothMouseDirectionInfo}"/>
                                        </controls:InfoRow>
                                        <ComboBox AutomationProperties.Name="{DynamicResource BluetoothPortraitMouseDirection}" ItemsSource="{Binding BluetoothMouseDirections}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedBluetoothPortraitMouseDirection, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource BluetoothLandscapeMouseDirection}"
                                                   Style="{StaticResource DetailLabel}" Margin="0,0,0,5"/>
                                        <ComboBox AutomationProperties.Name="{DynamicResource BluetoothLandscapeMouseDirection}" ItemsSource="{Binding BluetoothMouseDirections}"
                                                  DisplayMemberPath="Label"
                                                  SelectedItem="{Binding SelectedBluetoothLandscapeMouseDirection, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,10,0,0">
                                    <CheckBox Content="{DynamicResource BluetoothReverseHorizontal}"
                                              IsChecked="{Binding BluetoothMouseReverseHorizontal, Mode=TwoWay}"/>
                                    <CheckBox Content="{DynamicResource BluetoothReverseVertical}"
                                              IsChecked="{Binding BluetoothMouseReverseVertical, Mode=TwoWay}"
                                              Margin="18,0,0,0"/>
                                </WrapPanel>
                                <WrapPanel Style="{StaticResource ControlActions}" Margin="-4,8,-4,-4">
                                    <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource ApplyBluetoothMouseSettings}"
                                            Command="{Binding ApplyBluetoothMouseSettingsCommand}"
                                            Style="{StaticResource ToolButton}"
                                            AutomationProperties.AutomationId="ApplyBluetoothMouseSettingsButton"/>
                                    <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource ClearBluetoothBindings}"
                                            Click="OnClearBluetoothBindingsClick"
                                            Style="{StaticResource ToolButton}"
                                            AutomationProperties.AutomationId="ClearBluetoothBindingsButton"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- Wireless -->
                    <StackPanel x:Name="SettingsPageWireless" Visibility="Collapsed">
                        <Expander x:Name="SettingsSectionWirelessReceiver" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource WirelessReceiverTitle}"
                                  Visibility="{Binding WirelessReceiverSettingsVisibility}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="Cast20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WirelessReceiverTitle}" Style="{StaticResource ControlSectionTitle}"/>
                                        <DockPanel>
                                            <Ellipse Width="6" Height="6" chrome:StatusAppearance.Tone="{Binding WirelessStatusTone}"
                                                     VerticalAlignment="Center" Margin="0,2,6,0"/>
                                            <TextBlock Text="{Binding WirelessStatus}" Style="{StaticResource SettingsSectionSummary}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <controls:InfoRow Margin="0,0,0,5">
                                    <TextBlock Text="{DynamicResource WirelessBackendLabel}"
                                               Style="{StaticResource DetailLabel}" Margin="0"/>
                                    <controls:InfoTip Text="{Binding AppliedWirelessBackendDisplay}"/>
                                </controls:InfoRow>
                                <ComboBox AutomationProperties.Name="{DynamicResource WirelessBackendLabel}" ItemsSource="{Binding WirelessReceiverBackends}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedWirelessReceiverBackend, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="WirelessBackendComboBox"/>
                                <controls:InfoRow Margin="0,10,0,5">
                                    <TextBlock Text="{DynamicResource WirelessResolutionLabel}"
                                               Style="{StaticResource DetailLabel}" Margin="0"/>
                                    <controls:InfoTip Text="{Binding WirelessResolutionInfo}"/>
                                </controls:InfoRow>
                                <ComboBox AutomationProperties.Name="{DynamicResource WirelessResolutionLabel}" ItemsSource="{Binding WirelessDisplayProfiles}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedWirelessDisplayProfile, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="WirelessResolutionComboBox"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox AutomationProperties.Name="{DynamicResource WirelessReceiverNameLabel}" Text="{Binding WirelessReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource RoundedTextBox}"
                                             MaxLength="63" MinHeight="40"
                                             ToolTip="{DynamicResource WirelessReceiverNameLabel}"/>
                                    <Button Grid.Column="2" Content="{DynamicResource ApplyWirelessSettings}"
                                            Command="{Binding ApplyWirelessSettingsCommand}"
                                            Style="{StaticResource ToolButton}" MinWidth="64"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SettingsSectionMediaCast" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource MediaCastTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="VideoClip20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <controls:InfoRow>
                                            <TextBlock Text="{DynamicResource MediaCastTitle}" Style="{StaticResource ControlSectionTitle}" VerticalAlignment="Center"/>
                                            <controls:InfoTip Text="{DynamicResource MediaCastDescription}"/>
                                        </controls:InfoRow>
                                        <DockPanel>
                                            <Ellipse Width="6" Height="6" chrome:StatusAppearance.Tone="{Binding MediaCastStatusTone}"
                                                     VerticalAlignment="Center" Margin="0,2,6,0"/>
                                            <TextBlock Text="{Binding MediaCastStatus}" Style="{StaticResource SettingsSectionSummary}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding MediaCastReceiverName}"
                                           FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- App -->
                    <StackPanel x:Name="SettingsPageApp" Visibility="Collapsed">
                        <Expander x:Name="SettingsSectionAppearance" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource AppearanceTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="Color20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource AppearanceTitle}" Style="{StaticResource ControlSectionTitle}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ThemeModeTitle}"
                                           Style="{StaticResource DetailLabel}" Margin="0,0,0,5"/>
                                <Border CornerRadius="8" Padding="3" HorizontalAlignment="Left"
                                        Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1">
                                    <StackPanel x:Name="ThemeModeButtons" Orientation="Horizontal"
                                                AutomationProperties.Name="{DynamicResource ThemeModeTitle}">
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="ThemeMode" Tag="System"
                                                     Content="{DynamicResource ThemeSystem}" Checked="OnThemeModeChecked"
                                                     AutomationProperties.AutomationId="ThemeModeSystem"/>
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="ThemeMode" Tag="Light"
                                                     Content="{DynamicResource ThemeLight}" Checked="OnThemeModeChecked"
                                                     AutomationProperties.AutomationId="ThemeModeLight"/>
                                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="ThemeMode" Tag="Dark"
                                                     Content="{DynamicResource ThemeDark}" Checked="OnThemeModeChecked"
                                                     AutomationProperties.AutomationId="ThemeModeDark"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource ThemeTitle}"
                                           Style="{StaticResource DetailLabel}" Margin="0,12,0,5"/>
                                <UniformGrid x:Name="ThemeTiles" Columns="3" AutomationProperties.Name="{DynamicResource ThemeTitle}"/>
                                <TextBlock x:Name="ThemeDarkOnlyHint" Text="{DynamicResource ThemePresetDarkOnly}"
                                           Style="{StaticResource SettingsHelpText}" Margin="0,0,0,4" Visibility="Collapsed"/>
                                <!-- Kept for the shared selection handler and its tests; the tiles drive it. -->
                                <ComboBox AutomationProperties.Name="{DynamicResource ThemeTitle}" x:Name="ThemeComboBox" MinHeight="40"
                                          Visibility="Collapsed"
                                          AutomationProperties.AutomationId="ThemeComboBox"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="OnThemeSelectionChanged">
                                    <ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}"/>
                                    <ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}"/>
                                    <ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}"/>
                                    <ComboBoxItem Tag="Midnight" Content="{DynamicResource ThemeMidnight}"/>
                                    <ComboBoxItem Tag="Nord" Content="{DynamicResource ThemeNord}"/>
                                    <ComboBoxItem Tag="Sunset" Content="{DynamicResource ThemeSunset}"/>
                                    <ComboBoxItem Tag="Forest" Content="{DynamicResource ThemeForest}"/>
                                </ComboBox>
                                <controls:InfoRow Margin="0,10,0,5">
                                    <TextBlock Text="{DynamicResource AccentColorTitle}"
                                               Style="{StaticResource DetailLabel}" Margin="0"/>
                                    <controls:InfoTip Text="{DynamicResource AppearanceFrameHelp}"/>
                                </controls:InfoRow>
                                <WrapPanel x:Name="AccentSwatches" AutomationProperties.AutomationId="AccentSwatches"
                                           AutomationProperties.Name="{DynamicResource AccentColorTitle}"/>
                                <TextBox x:Name="AccentHexTextBox" Margin="0,4,0,0" MinHeight="36"
                                         FontFamily="{StaticResource CodeFontFamily}"
                                         ToolTip="{DynamicResource AccentColorHex}"
                                         AutomationProperties.AutomationId="AccentHexTextBox"
                                         AutomationProperties.Name="{DynamicResource AccentColorHex}"
                                         LostKeyboardFocus="OnAccentHexLostFocus" KeyDown="OnAccentHexKeyDown"/>
                                <TextBlock Text="{DynamicResource UiStyleTitle}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <UniformGrid x:Name="StyleTiles" Columns="3" AutomationProperties.Name="{DynamicResource UiStyleTitle}"/>
                                <ComboBox x:Name="UiStyleComboBox" MinHeight="40" Visibility="Collapsed"
                                          AutomationProperties.AutomationId="UiStyleComboBox"
                                          AutomationProperties.Name="{DynamicResource UiStyleTitle}"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="OnUiStyleSelectionChanged">
                                    <ComboBoxItem Tag="Modern" Content="{DynamicResource UiStyleModern}"/>
                                    <ComboBoxItem Tag="Playful" Content="{DynamicResource UiStylePlayful}"/>
                                    <ComboBoxItem Tag="Minimal" Content="{DynamicResource UiStyleMinimal}"/>
                                </ComboBox>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SettingsSectionAutoConnect" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource AutoConnectTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="PhoneCheckmark20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <controls:InfoRow>
                                            <TextBlock Text="{DynamicResource AutoConnectTitle}" Style="{StaticResource ControlSectionTitle}" VerticalAlignment="Center"/>
                                            <controls:InfoTip Text="{DynamicResource AutoConnectHelp}"/>
                                        </controls:InfoRow>
                                    </StackPanel>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <CheckBox Content="{DynamicResource AutoMirrorOnConnect}"
                                          IsChecked="{Binding AutoMirrorOnConnect, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="AutoMirrorOnConnectCheckBox"/>
                                <CheckBox Content="{DynamicResource AutoOpenPreviewOnConnect}" Margin="24,8,0,0"
                                          IsChecked="{Binding AutoOpenPreviewOnConnect, Mode=TwoWay}"
                                          IsEnabled="{Binding AutoMirrorOnConnect}"
                                          AutomationProperties.AutomationId="AutoOpenPreviewOnConnectCheckBox"/>
                                <CheckBox Content="{DynamicResource AutoStartControlOnConnect}" Margin="24,8,0,0"
                                          IsChecked="{Binding AutoStartControlOnConnect, Mode=TwoWay}"
                                          IsEnabled="{Binding AutoMirrorOnConnect}"
                                          AutomationProperties.AutomationId="AutoStartControlOnConnectCheckBox"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="AdvancedSettingsCard" Style="{StaticResource SettingsSection}"
                                  AutomationProperties.Name="{DynamicResource AppPreferencesTitle}">
                            <Expander.Header>
                                <DockPanel>
                                    <Border Style="{StaticResource SettingsSectionIcon}">
                                        <ui:SymbolIcon Symbol="Settings20" FontSize="16" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource AppPreferencesTitle}" Style="{StaticResource ControlSectionTitle}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ApplicationModeLabel}"
                                           Style="{StaticResource DetailLabel}" Margin="0,0,0,5"/>
                                <ComboBox AutomationProperties.Name="{DynamicResource ApplicationModeLabel}" SelectedValue="{Binding SelectedApplicationDisplayMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          AutomationProperties.AutomationId="ApplicationDisplayModeComboBox">
                                    <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Lightweight}"
                                                  Content="{DynamicResource ApplicationModeLightweight}"/>
                                    <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Complete}"
                                                  Content="{DynamicResource ApplicationModeComplete}"/>
                                    <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Tray}"
                                                  Content="{DynamicResource ApplicationModeTray}"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource LanguageToolTip}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox AutomationProperties.Name="{DynamicResource LanguageToolTip}" x:Name="LanguageComboBox" MinHeight="40"
                                          AutomationProperties.AutomationId="LanguageComboBox"
                                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          ToolTip="{DynamicResource LanguageToolTip}">
                                    <ComboBoxItem Tag="system" Content="{DynamicResource LanguageSystem}"/>
                                    <ComboBoxItem Tag="zh-CN" Content="{DynamicResource LanguageChinese}"/>
                                    <ComboBoxItem Tag="zh-HK" Content="{DynamicResource LanguageTraditionalChineseHongKong}"/>
                                    <ComboBoxItem Tag="zh-TW" Content="{DynamicResource LanguageTraditionalChineseTaiwan}"/>
                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}"/>
                                </ComboBox>
                                <WrapPanel Style="{StaticResource ControlActions}" Margin="-4,10,-4,-4">
                                    <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource SetupReopen}"
                                            Click="OnFirstRunSetupClick" Style="{StaticResource ToolButton}"/>
                                    <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource AdvancedSettings}"
                                            Command="{Binding AdvancedSettingsCommand}"
                                            Style="{StaticResource ToolButton}"
                                            Visibility="{Binding AdvancedSettingsVisibility}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    </Grid>
                </ScrollViewer>
                </Grid>
            </Border>
            </controls:WorkspaceRevealPanel>
        </Grid>

        <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="VersionButton"
                    Content="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{DynamicResource MutedTextBrush}" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0" Padding="0"
                    MinHeight="22" MinWidth="150" FontSize="{DynamicResource FontSize10}" FontWeight="Normal"
                    HorizontalAlignment="Right" Cursor="Hand" FocusVisualStyle="{x:Null}"
                    Focusable="True" IsTabStop="True" IsHitTestVisible="True"
                    AutomationProperties.AutomationId="VersionButton"
                    AutomationProperties.Name="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Click="OnVersionClick"/>
        </Grid>

        <Popup x:Name="PreviewTransitionMask"
               PlacementTarget="{Binding ElementName=PreviewPanel}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, ElementName=PreviewPanel}"
                  Height="{Binding ActualHeight, ElementName=PreviewPanel}"
                  Background="Transparent"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Border Margin="1,0,1,2"
                        Background="{DynamicResource PreviewChromeBrush}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True"/>
            </Grid>
        </Popup>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>

                        AutomationProperties.AutomationId="CaptureActionButton"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource CaptureActionButton}"
                        VerticalAlignment="Center"/>
                <Button x:Name="MoreMenuButton"
                        AutomationProperties.AutomationId="MoreMenuButton"
                        AutomationProperties.Name="{DynamicResource MoreActions}"
                        ToolTip="{DynamicResource MoreActions}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{StaticResource ToolButton}" MinHeight="40" MinWidth="40"
                        Margin="8,0,0,0" Padding="10,8"
                        VerticalAlignment="Center" Click="OnMoreMenuClick">
                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="MoreHorizontal20" FontSize="18"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" Style="{StaticResource DeviceContextMenuStyle}" Placement="Bottom">
                            <MenuItem Header="{DynamicResource AboutTitle}" Click="OnAboutClick"
                                      AutomationProperties.AutomationId="MoreMenuAbout"/>
                            <MenuItem Header="{DynamicResource DiagnosticsTitle}" Click="OnMoreMenuDiagnosticsClick"
                                      AutomationProperties.AutomationId="MoreMenuDiagnostics"/>
                            <MenuItem x:Name="VersionLauncherMenuItem" Header="{DynamicResource OpenVersionLauncher}"
                                      Click="OnOpenVersionLauncherClick" Visibility="Collapsed"
                                      AutomationProperties.AutomationId="MoreMenuVersionLauncher"/>
                            <Separator/>
                            <MenuItem x:Name="ExitAppMenuItem" Header="{DynamicResource TrayExit}" Click="OnCloseWindowClick"
                                      Foreground="{DynamicResource ErrorBrush}"
                                      AutomationProperties.AutomationId="ExitAppMenuItem"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="5" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}"
                        AutomationProperties.Name="{DynamicResource Minimize}"
                        Click="OnMinimizeClick">
                    <Button.ToolTip>
                        <ToolTip FontFamily="{DynamicResource NavigationTextFontFamily}"
                                 FontSize="12"
                                 Content="{DynamicResource TitleBarMinimizeToolTip}"/>
                    </Button.ToolTip>
                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Subtract20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}"
                        AutomationProperties.Name="{DynamicResource Maximize}"
                        Click="OnMaximizeClick">
                    <Button.ToolTip>
                        <ToolTip FontFamily="{DynamicResource NavigationTextFontFamily}"
                                 FontSize="12"
                                 Content="{DynamicResource TitleBarMaximizeToolTip}"/>
                    </Button.ToolTip>
                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Maximize20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource TitleBarCloseButton}"
                        AutomationProperties.Name="{DynamicResource Close}"
                        Click="OnCloseWindowClick">
                    <Button.ToolTip>
                        <ToolTip FontFamily="{DynamicResource NavigationTextFontFamily}"
                                 FontSize="12"
                                 Content="{DynamicResource TitleBarCloseToolTip}"/>
                    </Button.ToolTip>
                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="17"/>
                </Button>
            </StackPanel>
        </Grid>

        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="2" UseLayoutRounding="True" SizeChanged="OnWorkspaceLayoutChanged" Loaded="OnWorkspaceLayoutChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DeviceColumn" Width="Auto"/>
                <ColumnDefinition x:Name="LeftGapColumn" Width="18"/>
                <ColumnDefinition x:Name="CenterColumn" Width="*"/>
                <ColumnDefinition x:Name="RightGapColumn" Width="0"/>
                <ColumnDefinition x:Name="ControlColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:WorkspaceRevealPanel x:Name="LeftPanelHost" Grid.Column="0" Width="300" ContentWidth="300" IsVisibleChanged="OnWorkspacePanelVisibilityChanged"
                  ClipToBounds="True">
            <Border x:Name="DevicePanel" IsVisibleChanged="OnWorkspacePanelVisibilityChanged" Unloaded="OnWorkspaceUnloaded"
                    Style="{StaticResource WorkspaceCardBorder}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource DevicesTitle}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DeviceCount}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" FontSize="{DynamicResource SecondaryFontSize}"/>
                        <Button Grid.Column="3" Style="{StaticResource WorkspaceIconButton}"
                                Width="32" Height="32" MinHeight="32" Margin="0" Padding="0"
                                Click="OnCloseDevicePanelClick" ToolTip="{DynamicResource Close}"
                                AutomationProperties.AutomationId="CloseDevicePanelButton">
                            <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="16"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource ControlSectionCard}" Margin="0" Padding="12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource CurrentDevice}" Style="{StaticResource ControlSectionTitle}"/>
                                <TextBlock Text="{Binding SelectedConnection}" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedName}" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding SelectedModel}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource CaptionFontSize}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SelectedOs}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                            <TextBlock Text="{Binding SelectedUdid}" FontFamily="{StaticResource CodeFontFamily}" FontSize="{DynamicResource CaptionFontSize}"
                                       AutomationProperties.AutomationId="SelectedDeviceUdidText"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderSoftBrush}"
                            VerticalAlignment="Center" Margin="2,0"/>
                    <ListBox x:Name="DeviceListBox" Grid.Row="4" ItemsSource="{Binding Devices}"
                             AutomationProperties.AutomationId="DeviceListBox"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnDeviceListLeftButtonDown"
                             PreviewMouseMove="OnDeviceListMouseMove"
                             PreviewMouseLeftButtonUp="OnDeviceListLeftButtonUp"
                             PreviewMouseRightButtonDown="OnDeviceListRightButtonDown"
                             DragOver="OnDeviceListDragOver"
                             Drop="OnDeviceListDrop">
                        <ListBox.Resources>
                            <Style TargetType="ContextMenu" BasedOn="{StaticResource DeviceContextMenuStyle}"/>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource DeviceMenuItemStyle}"/>
                            <ContextMenu x:Key="DeviceContextMenu" Placement="MousePoint">
                                <MenuItem Header="{DynamicResource MirrorSimultaneously}"
                                          Click="OnMirrorSimultaneouslyClick"/>
                            </ContextMenu>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource DeviceContextMenu}"/>
                                <Setter Property="AutomationProperties.AutomationId"
                                        Value="{Binding AutomationId}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.AutomationId="{Binding AutomationId}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="48" CornerRadius="6" BorderThickness="2"
                                            BorderBrush="{DynamicResource MutedTextBrush}" VerticalAlignment="Top">
                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedTextBrush}"
                                                 VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{DynamicResource SectionTitleFontSize}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModelDisplay}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource CaptionFontSize}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding OsDisplay}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{DynamicResource CaptionFontSize}"/>
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="{DynamicResource CaptionFontSize}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="5">
                        <Button x:Name="RefreshDevicesButton"
                                Content="{DynamicResource RefreshDevices}" Command="{Binding RefreshCommand}"
                                Background="{DynamicResource ControlFillBrush}"/>
                        <TextBlock Text="{DynamicResource KeepUnlocked}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource CaptionFontSize}" TextAlignment="Center" Margin="0,9,0,0"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <Border x:Name="MirroringPanel" IsVisibleChanged="OnWorkspacePanelVisibilityChanged" Unloaded="OnWorkspaceUnloaded"
                    Style="{StaticResource WorkspaceCardBorder}" Padding="16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{DynamicResource NavMirroring}" FontSize="{DynamicResource FontSize16}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource WorkspaceIconButton}"
                                Width="32" Height="32" MinHeight="32" Margin="0" Padding="0"
                                HorizontalAlignment="Right" Click="OnCloseMirroringPanelClick"
                                ToolTip="{DynamicResource Close}"
                                AutomationProperties.AutomationId="CloseMirroringPanelButton">
                            <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="16"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <Button Command="{Binding MoreImageSettingsCommand}"
                                Style="{StaticResource ToolButton}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ImageEdit20" FontSize="16"/>
                                <TextBlock Text="{DynamicResource IndependentWindowImageSettings}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnPreviewWindowClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="WindowNew20" FontSize="15"/>
                                <TextBlock Text="{DynamicResource SeparateWindow}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnPreviewSettingsClick" Style="{StaticResource ToolButton}" Margin="0,0,0,8"
                                ToolTip="{DynamicResource PreviewSettingsDescription}"
                                AutomationProperties.AutomationId="PreviewSettingsButton">
                            <StackPanel Orientation="Horizontal">
                                <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Settings20" FontSize="15"/>
                                <TextBlock Text="{DynamicResource PreviewSettingsTitle}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnScreenshotClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Screenshot20" FontSize="15"/>
                                <TextBlock Text="{DynamicResource Screenshot}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnRefreshPreviewClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True"><controls:ThemedSymbolIcon DockPanel.Dock="Left" Style="{StaticResource ButtonSymbolIcon}" Symbol="ArrowClockwise20" FontSize="15"/><TextBlock TextWrapping="Wrap" Text="{DynamicResource RefreshFrame}" Margin="9,0,0,0"/></DockPanel>
                        </Button>
                        <Button Click="OnFullScreenClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}">
                            <DockPanel LastChildFill="True"><controls:ThemedSymbolIcon DockPanel.Dock="Left" Style="{StaticResource ButtonSymbolIcon}" Symbol="FullScreenMaximize20" FontSize="15"/><TextBlock TextWrapping="Wrap" Text="{DynamicResource FullScreenPreview}" Margin="9,0,0,0"/></DockPanel>
                        </Button>
                    </StackPanel></ScrollViewer>
                </Grid>
            </Border>
            </controls:WorkspaceRevealPanel>

            <Grid x:Name="CenterPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="StatsGapRow" Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">

                <Border x:Name="EnvironmentPanel" Grid.Row="0"
                        Margin="0,0,0,14" Padding="10,9,10,9">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource WorkspaceCardBorder}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewAndObsVisibility}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:AdaptiveToolbar x:Name="PreviewToolbarScrollViewer" Grid.ColumnSpan="2"
                                      Style="{StaticResource HorizontalContentScrollViewer}">
                        <StackPanel x:Name="PreviewQuickActions"
                                    Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding PreviewAndObsVisibility}">
                            <Button ToolTip="{DynamicResource StopMirroring}"
                                    AutomationProperties.Name="{DynamicResource StopMirroring}"
                                    AutomationProperties.AutomationId="ToolbarStopButton">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PreviewToolButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Command" Value="{Binding StopCommand}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMediaCasting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Command" Value="{Binding MediaCastStopCommand}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowToolbarStop}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Stop20" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource StopMirroring}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnStartWirelessControlClick"
                                    IsEnabled="{Binding CanToggleWirelessControl}"
                                    Style="{StaticResource PreviewToolButton}"
                                    ToolTip="{Binding WirelessControlActionText}"
                                    AutomationProperties.Name="{DynamicResource WirelessControlLabel}"
                                    AutomationProperties.AutomationId="WirelessControlButton"
                                    Visibility="{Binding ShowToolbarWirelessControl, Converter={StaticResource ToolbarItemVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Wifi120" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource WirelessControlLabel}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnStartUsbControlClick"
                                    IsEnabled="{Binding CanToggleWiredControl}"
                                    Style="{StaticResource PreviewToolButton}"
                                    ToolTip="{Binding WiredControlActionText}"
                                    AutomationProperties.Name="{DynamicResource WiredControlLabel}"
                                    AutomationProperties.AutomationId="UsbControlButton"
                                    Visibility="{Binding ShowToolbarUsbControl, Converter={StaticResource ToolbarItemVisibility}}"
                                    AutomationProperties.ItemStatus="{Binding UsbControlStatus}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="UsbPlug24" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource WiredControlLabel}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnStartBluetoothControlClick"
                                    IsEnabled="{Binding CanStartBluetoothControl}"
                                    Style="{StaticResource PreviewToolButton}"
                                    ToolTip="{Binding BluetoothControlActionText}"
                                    AutomationProperties.Name="{DynamicResource BluetoothControlLabel}"
                                    AutomationProperties.AutomationId="BluetoothControlButton"
                                    Visibility="{Binding ShowToolbarBluetoothControl, Converter={StaticResource ToolbarItemVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Cursor20" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource BluetoothControlLabel}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="QuickMediaOutputButton"
                                    Click="OnMediaOutputToolbarClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource MediaOutputButton}"
                                    AutomationProperties.Name="{DynamicResource MediaOutputButton}"
                                    AutomationProperties.AutomationId="QuickMediaOutputButton"
                                    Visibility="{Binding ShowToolbarMediaOutput, Converter={StaticResource ToolbarItemVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                     <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="VideoRecording20" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource MediaOutputButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="QuickImageSettingsButton" Command="{Binding MoreImageSettingsCommand}"
                                    Style="{StaticResource PreviewToolButton}"
                                    ToolTip="{DynamicResource IndependentWindowImageSettings}"
                                    AutomationProperties.Name="{DynamicResource IndependentWindowImageSettings}"
                                    AutomationProperties.AutomationId="QuickImageSettingsButton"
                                    Visibility="{Binding ShowToolbarImageSettings, Converter={StaticResource ToolbarItemVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ImageEdit20" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource IndependentWindowImageSettings}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="QuickPreviewWindowButton" Click="OnPreviewWindowClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource SeparateWindow}"
                                    AutomationProperties.Name="{DynamicResource SeparateWindow}"
                                    AutomationProperties.AutomationId="QuickPreviewWindowButton"
                                    Visibility="{Binding ShowToolbarPreviewWindow, Converter={StaticResource ToolbarItemVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="WindowNew20" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource SeparateWindow}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="QuickScreenshotButton" Click="OnScreenshotClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource Screenshot}"
                                    AutomationProperties.Name="{DynamicResource Screenshot}"
                                    AutomationProperties.AutomationId="QuickScreenshotButton"
                                    Visibility="{Binding ShowToolbarScreenshot, Converter={StaticResource ToolbarItemVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Screenshot20" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource Screenshot}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="QuickFullScreenButton" Click="OnFullScreenClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource FullScreenPreview}"
                                    AutomationProperties.Name="{DynamicResource FullScreenPreview}"
                                    AutomationProperties.AutomationId="QuickFullScreenButton"
                                    Visibility="{Binding ShowToolbarFullScreen, Converter={StaticResource ToolbarItemVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ThemedSymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="FullScreenMaximize20" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource FullScreenPreview}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="PreviewVolume" CornerRadius="8" Padding="3" Margin="4,0,0,0"
                                    VerticalAlignment="Center" Background="{DynamicResource ControlFillBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                    AutomationProperties.AutomationId="PreviewVolume">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMediaCasting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowToolbarVolume}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Button MinWidth="34" MinHeight="32" Padding="6,4"
                                            Click="OnToolbarMuteClick" AutomationProperties.AutomationId="PlaybackMuteButton">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                                <Setter Property="ToolTip" Value="{DynamicResource PreviewMute}"/>
                                                <Setter Property="AutomationProperties.Name" Value="{DynamicResource PreviewMute}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="ToolTip" Value="{DynamicResource PreviewUnmute}"/>
                                                        <Setter Property="AutomationProperties.Name" Value="{DynamicResource PreviewUnmute}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <controls:ThemedSymbolIcon FontSize="17">
                                            <controls:ThemedSymbolIcon.Style>
                                                <Style TargetType="controls:ThemedSymbolIcon" BasedOn="{StaticResource ButtonSymbolIcon}">
                                                    <Setter Property="Symbol" Value="Speaker220"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Symbol" Value="SpeakerMute20"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:ThemedSymbolIcon.Style>
                                        </controls:ThemedSymbolIcon>
                                    </Button>
                                    <StackPanel x:Name="PcVolumeControls" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AudioOnIphone}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="PC" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                        <Slider x:Name="PreviewVolumeSlider" Width="88" Minimum="0" Maximum="100"
                                                Margin="6,0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                Value="{Binding PlaybackVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{DynamicResource PlaybackVolume}"
                                                AutomationProperties.AutomationId="PreviewVolumeSlider"/>
                                        <TextBlock Text="{Binding PlaybackVolume, StringFormat={}{0:F0} %}" MinWidth="38"
                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="IphoneVolumeControls" Orientation="Horizontal"
                                                ToolTipService.ShowOnDisabled="True">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="ToolTip" Value="{DynamicResource IphoneVolumeSliderHelp}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasIphoneVolumeTarget}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CanControlIphoneVolume}" Value="False">
                                                        <Setter Property="ToolTip" Value="{DynamicResource IphoneVolumeNeedsControl}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="iPhone" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                        <!-- The iPhone level cannot be read: this slider presses its
                                             volume buttons and resynchronizes at either end. -->
                                        <Slider x:Name="IphoneVolumeSlider" Width="88" Minimum="0" Maximum="16"
                                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"
                                                Margin="6,0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                IsEnabled="{Binding CanControlIphoneVolume}"
                                                Value="{Binding IphoneVolumeLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{DynamicResource IphoneVolumeSliderName}"
                                                AutomationProperties.AutomationId="IphoneVolumeSlider"/>
                                        <TextBlock Text="{Binding IphoneVolumePercent, StringFormat={}{0:F0} %}" MinWidth="38"
                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </controls:AdaptiveToolbar>
                    </Grid>
                </Border>

                <!-- Reverse-control status cards. Kept above the preview rather
                     than over it: the native preview HWND hides WPF overlays. -->
                <controls:ReverseControlStatusHost x:Name="ReverseControlStatusCards" Margin="0,0,0,6"
                                                   SharesHeightWith="{Binding ElementName=PreviewPanel}"/>

                </StackPanel>

                <Border x:Name="PreviewPanel" Grid.Row="1" Background="{DynamicResource PreviewChromeBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" ClipToBounds="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        MinWidth="0" MinHeight="0" SnapsToDevicePixels="True"
                        SizeChanged="OnPreviewPanelSizeChanged">
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
